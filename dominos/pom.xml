<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent — il gère les versions de toutes les dépendances.
        Vous n'avez pas à chercher quelle version de JPA est compatible
        avec quelle version de Hibernate — Spring Boot s'en occupe.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dominos</groupId>
    <artifactId>dominos</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!--
            spring-boot-starter-data-jpa
            Inclut : Spring Data JPA + Hibernate (implémentation JPA) + JDBC
            C'est ce qui nous permet de mapper des classes Java vers des tables SQL
            et de générer les requêtes automatiquement.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-web
            Inclut : serveur Tomcat embarqué + Spring MVC (REST)
            Nécessaire à l'Étape 5 pour les endpoints HTTP.
            On l'ajoute maintenant pour que Spring Boot démarre correctement.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Pilote PostgreSQL
            Permet à Java de parler à PostgreSQL.
            "runtime" = utilisé au lancement, pas à la compilation.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Tests : Spring Boot Test + JUnit 5
            spring-boot-starter-test inclut JUnit 5, Mockito, AssertJ.
            On garde nos tests existants — ils sont compatibles JUnit 5.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 — base de données en mémoire pour les tests
            Permet de tester JPA sans avoir besoin de PostgreSQL.
            "test" = utilisé uniquement pendant mvn test.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin
                Permet de lancer l'application avec : mvn spring-boot:run
                Et de créer un JAR exécutable avec : mvn package
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
